---
import { footer } from '../i18n/en';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-cols">
      {footer.columns.map((col) => (
        <div>
          <h2 class="footer-title">{col.title}</h2>
          <ul>
            {col.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <p class="footer-bottom">
      © {year} {footer.copyright} · <a href={footer.license.href}>{footer.license.label}</a> · {footer.madeIn} · <a href={footer.source.href}>{footer.source.label}</a>
    </p>
  </div>
</footer>
